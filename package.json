{
  "name": "youtubeenhance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "build:css": "sass src/styles/styles.scss src/output.css && tailwindcss build src/output.css -o src/final.css",
    "watch:sass": "sass --watch src/styles/styles.scss:src/output.css",
    "watch:tailwind": "tailwindcss -i ./src/output.css -o ./src/final.css --watch",
    "watch:styles": "npm-run-all --parallel watch:sass watch:tailwind",
    "build:sass": "sass src/styles/styles.scss src/output.css",
    "build:tailwind": "tailwindcss -i ./src/output.css -o ./src/final.css",
    "build:styles": "npm-run-all build:sass build:tailwind",
    "start": "node server.js"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.5",
    "@tanstack/react-query": "^5.45.0",
    "@tanstack/react-query-devtools": "^5.45.0",
    "@vercel/analytics": "^1.4.1",
    "axios": "^1.7.7",
    "concurrently": "^9.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-infinite-scroll-component": "^6.1.0",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.23.1",
    "redux-persist": "^6.0.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/redux-persist": "^4.3.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.38",
    "sass": "^1.77.4",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}
